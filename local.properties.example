## This file is a template.
## Copy this file to local.properties and fill in your actual values.
## local.properties is gitignored — never commit it.

# Android SDK path (required by Gradle)
# Windows example:
# sdk.dir=C\:\\Users\\YOUR_USERNAME\\AppData\\Local\\Android\\Sdk
# macOS/Linux example:
# sdk.dir=/Users/YOUR_USERNAME/Library/Android/sdk

# Google Maps API key
# Used for: Android Maps SDK (map rendering) AND Directions web-service API
# ⚠️  See google_maps_api.debug.xml.example for key restriction notes
# Get your key at: https://console.cloud.google.com → APIs & Services → Credentials
MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# Python/FastAPI backend base URL
# For local development run: python main.py  then  .\ngrok http 8000
# Paste the ngrok HTTPS forwarding URL here (include trailing slash)
# Example: BACKEND_BASE_URL=https://xxxx-xx-xx-xxx-xx.ngrok-free.app/
BACKEND_BASE_URL=YOUR_BACKEND_BASE_URL_HERE
