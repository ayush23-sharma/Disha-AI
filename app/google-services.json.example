{
  "_comment": "This is a template. Copy this file to google-services.json and replace ALL placeholder values with real ones from your Firebase project. Never commit the real google-services.json.",
  "_setup": "1. Go to https://console.firebase.google.com  2. Open your project (or create one)  3. Project Settings → Your apps → Android app  4. Download google-services.json and place it at app/google-services.json",
  "project_info": {
    "project_number": "YOUR_PROJECT_NUMBER",
    "project_id": "YOUR_PROJECT_ID",
    "storage_bucket": "YOUR_PROJECT_ID.firebasestorage.app"
  },
  "client": [
    {
      "client_info": {
        "mobilesdk_app_id": "YOUR_MOBILESDK_APP_ID",
        "android_client_info": {
          "package_name": "com.shubham.womensafety"
        }
      },
      "oauth_client": [
        {
          "client_id": "YOUR_ANDROID_OAUTH_CLIENT_ID.apps.googleusercontent.com",
          "client_type": 1,
          "android_info": {
            "package_name": "com.shubham.womensafety",
            "certificate_hash": "YOUR_DEBUG_SHA1_CERTIFICATE_HASH"
          }
        },
        {
          "client_id": "YOUR_WEB_OAUTH_CLIENT_ID.apps.googleusercontent.com",
          "client_type": 3
        }
      ],
      "api_key": [
        {
          "current_key": "YOUR_FIREBASE_API_KEY"
        }
      ],
      "services": {
        "appinvite_service": {
          "other_platform_oauth_client": [
            {
              "client_id": "YOUR_WEB_OAUTH_CLIENT_ID.apps.googleusercontent.com",
              "client_type": 3
            }
          ]
        }
      }
    }
  ],
  "configuration_version": "1"
}
